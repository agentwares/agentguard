{
  "name": "@agentwares/agentguard-core",
  "version": "0.1.1",
  "description": "Policy engine behind agentguard: spend caps, destructive-action gating with approvals, kill switch, scoped agent keys, dry-run writes, semantic loop breaker, blast-radius caps and a hash-chained audit log. Web-standard core, Node stores under ./node.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agentwares/agentguard",
    "directory": "packages/agentguard-core"
  },
  "keywords": [
    "agentguard",
    "mcp",
    "ai-agents",
    "spend-limit",
    "kill-switch",
    "policy",
    "audit-log",
    "dry-run"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "homepage": "https://github.com/agentwares/agentguard/tree/main/packages/agentguard-core#readme",
  "bugs": {
    "url": "https://github.com/agentwares/agentguard/issues"
  }
}
